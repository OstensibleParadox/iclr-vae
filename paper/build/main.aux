\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The operator-ideal boundary appears only under refinement.} Power-law precision spectra traverse $\mathcal  {S}_{1}$, $\mathcal  {S}_{2}\setminus \mathcal  {S}_{1}$, the critical boundary, and the non-$\mathcal  {S}_{2}$ regime. Ordinary trace and determinant components drift separately, while the Wick--$\det _2$ finite part and its stochastic fluctuation are controlled exactly when $\left \lVert H_N \right \rVert _{\mathcal  {S}_{2}}^2$ is controlled.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:phase-boundary}{{1}{6}{\textbf {The operator-ideal boundary appears only under refinement.} Power-law precision spectra traverse $\Schatten {1}$, $\Schatten {2}\setminus \Schatten {1}$, the critical boundary, and the non-$\Schatten {2}$ regime. Ordinary trace and determinant components drift separately, while the Wick--$\det _2$ finite part and its stochastic fluctuation are controlled exactly when $\hsnorm {H_N}^2$ is controlled}{figure.1}{}}
\newlabel{fig:phase-boundary@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
